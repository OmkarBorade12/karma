# ── KARMA backend configuration ──────────────────────────────────────────────
PORT=5001

# MongoDB (Atlas or local). If unreachable, the API falls back to an
# in-memory demo database (data lives for the process lifetime only).
MONGODB_URI=mongodb://127.0.0.1:27017/karma
KARMA_IN_MEMORY_DB=

# Qdrant vector database. Leave empty to use qdrant-client's embedded
# in-memory mode (zero installs). Set for the Docker Compose stack:
#   QDRANT_URL=http://qdrant:6333
QDRANT_URL=
KARMA_QDRANT_COLLECTION=karma_chunks

# Redis cache. Leave empty to use an in-process cache fallback.
REDIS_URL=

# Autopilot (APScheduler cron agent)
KARMA_AUTOPILOT_ENABLED=false
KARMA_AUTOPILOT_CRON=*/15 * * * *

# LLM uplift — GPT-4o (OpenAI) and/or Gemini (Google).
# Any configured provider enables grounded answer synthesis + LLM reranking;
# failures always fall back to the local extractive pipeline.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Chunker tuning
KARMA_CHUNK_MAX_CHARS=700
KARMA_CHUNK_MIN_CHARS=120
