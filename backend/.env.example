PORT=5001
# Where the MongoDB lives
MONGODB_URI=mongodb://127.0.0.1:27017/karma
# Set to 1 to have the backend self-start a temporary in-memory MongoDB (no install needed)
KARMA_IN_MEMORY_DB=
# Start the autonomous agent automatically on boot
KARMA_AUTOPILOT_ENABLED=false
# Cron for autopilot cycles (every 15 min by default)
KARMA_AUTOPILOT_CRON=*/15 * * * *
# Optional: any OpenAI-compatible endpoint for answer-synthesis uplift (local engine used otherwise)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
